# Copy to .env and fill in real values. NEVER commit the real .env.

# ─── SMTP (contact form) ──────────────────────────────────
MAIL_USERNAME=your-smtp-user@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_FROM=no-reply@mfleet.org
MAIL_TO=info@mfleet.org

# ─── Database (PostgreSQL, dev & prod) ────────────────────
# Driver: psycopg 3 → use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://mfleet_app:change-me@localhost:5432/mfleet

# ─── Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Fernet key for encrypting SSN / banking data at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# ─── First admin (seeded via: python -m scripts.seed_admin) ─
ADMIN_EMAIL=admin@mfleet.org
ADMIN_PASSWORD=change-me-strong-password

# ─── Frontend base URL (for building driver apply links) ──
FRONTEND_BASE_URL=http://localhost:5173

# ─── Generated PDFs output directory ──────────────────────
GENERATED_PDF_DIR=./generated_pdfs

# ─── Driver-uploaded documents (medical cert, license, …) ─
# Filesystem store, served only through guarded endpoints (never mounted static).
UPLOADS_DIR=./uploads
